FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    openssh-server \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    net-tools \
    iputils-ping \
    procps \
    zabbix-agent \
    && rm -rf /var/lib/apt/lists/*

# ── Intentionally weak SSH config (LAB ONLY) ─────────────────────────────
RUN mkdir -p /var/run/sshd && \
    echo 'root:victim123' | chpasswd && \
    useradd -m -s /bin/bash labuser && \
    echo 'labuser:victim123' | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    touch /var/log/auth.log && chmod 644 /var/log/auth.log

# ── Vulnerable mini web app ───────────────────────────────────────────────
RUN python3 -m venv /venv && \
    /venv/bin/pip install --no-cache-dir flask requests psutil python-dotenv

ENV PATH="/venv/bin:$PATH"

COPY victim/services/webapp.py /webapp.py
COPY victim/agent/agent.py /agent/agent.py

# ── Fake vulnerable packages (for VOC inventory scanning) ────────────────
RUN echo "openssh-server 8.2p1" > /etc/vulnerable_packages.txt && \
    echo "python3 3.10.6" >> /etc/vulnerable_packages.txt && \
    echo "nginx 1.18.0" >> /etc/vulnerable_packages.txt && \
    echo "log4j-core 2.14.0" >> /etc/vulnerable_packages.txt

COPY docker/victim_start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 22 8080

CMD ["/start.sh"]