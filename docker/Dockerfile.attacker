FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap sshpass netcat-openbsd iputils-ping curl net-tools \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir requests psutil python-dotenv

WORKDIR /attacker

COPY attacker/attacks.py .
COPY attacker/attacker_server.py .

EXPOSE 5000

CMD ["python", "attacker_server.py"]