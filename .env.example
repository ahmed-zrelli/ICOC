# ── ICOC-Lite Environment Configuration ──────────────────────────────────────

# Demo mode: true = synthetic lab data, no real nmap/network scans needed
DEMO_MODE=true

# Lab network (used in live mode only)
LAB_NETWORK=192.168.100.0/24

# PostgreSQL connection (matches docker-compose db service)
POSTGRES_URL=postgresql://icoc:icoc2026@db:5432/icoc

# VirusTotal API key (free tier: 4 req/min, 500/day)
# Get yours at: https://www.virustotal.com/gui/join-us
# Leave blank to disable VT enrichment
VIRUSTOTAL_API_KEY=

# NVD API key (optional — increases rate limit from 5 to 50 req/30s)
# Get yours at: https://nvd.nist.gov/developers/request-an-api-key
# Leave blank to use unauthenticated access (slower)
NVD_API_KEY=